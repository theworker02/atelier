<Window x:Class="Atelier.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Atelier" Height="820" Width="1280" MinHeight="650" MinWidth="980" Background="#0B1016" Foreground="#EAF0F7" FontFamily="Segoe UI">
  <Window.Resources><Style TargetType="Button"><Setter Property="Background" Value="#1A2532"/><Setter Property="Foreground" Value="#EAF0F7"/><Setter Property="BorderBrush" Value="#2B3B4C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,8"/><Setter Property="Cursor" Value="Hand"/></Style><Style TargetType="TextBox"><Setter Property="Background" Value="#101923"/><Setter Property="Foreground" Value="#EAF0F7"/><Setter Property="BorderBrush" Value="#2B3B4C"/><Setter Property="Padding" Value="10,8"/></Style><Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D8E1EA"/><Setter Property="Margin" Value="0,5"/></Style></Window.Resources>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
    <Border Background="#0E151D" BorderBrush="#1F2C3A" BorderThickness="0,0,1,0"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="ATELIER" FontWeight="SemiBold" FontSize="24"/><TextBlock Text="LOCAL WORKSPACE" Foreground="#7F93A8" FontSize="11" Margin="0,4,0,18"/><Border Background="#121E2A" BorderBrush="#293A4C" BorderThickness="1" CornerRadius="6" Padding="10"><TextBlock Text="Search workspace   Ctrl K" Foreground="#8CA0B5"/></Border></StackPanel><StackPanel Grid.Row="1" Margin="0,28,0,0"><TextBlock Text="WORKSPACE" Foreground="#71869B" FontSize="11" Margin="8,0,0,8"/><Border Background="#172536" CornerRadius="6" Padding="11"><TextBlock Text="Review queue" FontWeight="SemiBold"/></Border><TextBlock Text="Notes" Margin="12,14,0,0"/><TextBlock Text="Audit timeline" Margin="12,14,0,0"/></StackPanel><StackPanel Grid.Row="2" VerticalAlignment="Bottom"><TextBlock Text="PROJECTS" Foreground="#71869B" FontSize="11" Margin="8,0,0,10"/><TextBlock Text="Personal" Margin="12,0,0,12"/><TextBlock Text="Research" Margin="12,0,0,12"/><TextBlock Text="Experiments" Margin="12,0,0,12"/></StackPanel><Border Grid.Row="3" Background="#101923" BorderBrush="#293A4C" BorderThickness="1" CornerRadius="6" Padding="12"><StackPanel><TextBlock Text="●  Local mode" Foreground="#68D391" FontWeight="SemiBold"/><TextBlock Text="No telemetry or provider calls" Foreground="#8294A7" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border></Grid></Border>
    <Grid Grid.Column="1" Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><StackPanel><TextBlock Text="Workspace review" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Review local context and approve only the actions you intend." Foreground="#91A3B6" Margin="0,5,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="Choose folder" Click="ChooseFolder_Click" Background="#2878E8" BorderBrush="#4B96FF" FontWeight="SemiBold"/></DockPanel><Border Grid.Row="1" Background="#101923" BorderBrush="#2B3B4C" BorderThickness="1" CornerRadius="8" Margin="0,24,0,18" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="CURRENT LOCAL WORKSPACE" Foreground="#8498AD" FontSize="11"/><TextBox Grid.Row="1" x:Name="WorkspacePath" IsReadOnly="True" Margin="0,8,0,14"/><DockPanel Grid.Row="2"><StackPanel><TextBlock Text="Proposed review scope" FontWeight="SemiBold"/><TextBlock Text="No files are read, uploaded, or edited by this MVP." Foreground="#90A2B5" FontSize="12" Margin="0,3,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Record review" Click="RecordReview_Click" Background="#2878E8" BorderBrush="#4B96FF" Margin="0,0,8,0"/><Button Content="Clear audit" Click="ClearAudit_Click"/></StackPanel></DockPanel></Grid></Border><Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><TextBlock Text="Audit timeline" FontSize="18" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="LOCAL ONLY" Foreground="#7E94AA" FontSize="11" VerticalAlignment="Center"/></DockPanel><TextBox Grid.Row="1" x:Name="AuditLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0E151D" BorderBrush="#2B3B4C"/></Grid></Grid>
    <Border Grid.Column="2" Background="#0E151D" BorderBrush="#1F2C3A" BorderThickness="1,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22"><TextBlock Text="Inspector" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="PERMISSIONS &amp; CONTEXT" Foreground="#7890A6" FontSize="11" Margin="0,4,0,24"/><TextBlock Text="Review permissions" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Select what this review may propose. Nothing runs automatically." Foreground="#8DA0B4" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,12"/><Border Background="#121E2A" BorderBrush="#2B3B4C" BorderThickness="1" CornerRadius="6" Padding="12"><StackPanel><CheckBox x:Name="WriteApproval" Content="Approve proposed workspace writes"/><CheckBox x:Name="NetworkApproval" Content="Approve network access"/></StackPanel></Border><Separator Margin="0,24" Background="#2A3A4A"/><TextBlock Text="Workspace note" FontWeight="SemiBold"/><TextBlock Text="Saved locally with this device." Foreground="#8DA0B4" FontSize="12" Margin="0,5,0,10"/><TextBox x:Name="WorkspaceNote" TextWrapping="Wrap" Height="110" AcceptsReturn="True"/><Button Content="Save local note" Click="SaveNote_Click" Margin="0,10,0,0"/><Border Background="#111A25" BorderBrush="#263B52" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,24,0,0"><StackPanel><TextBlock Text="Privacy boundary" Foreground="#71B7FF" FontWeight="SemiBold"/><TextBlock Text="Atelier v1.2 stores its audit and note locally. It makes no network or provider requests." TextWrapping="Wrap" Foreground="#A2B2C1" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></Border>
    <TextBlock Grid.Column="1" VerticalAlignment="Bottom" Margin="30" x:Name="Status" Foreground="#71B7FF"/>
  </Grid>
</Window>

