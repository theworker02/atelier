<Window x:Class="Atelier.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Atelier" Height="520" Width="780" Background="#111315" Foreground="#F5F2EA">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="ATELIER" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Local-first workspace foundation" Foreground="#AAB2BA" Margin="0,4,0,22"/>
      <DockPanel><Button Content="Choose folder" Click="ChooseFolder_Click" Padding="14,7" Margin="0,0,10,0"/><TextBox x:Name="WorkspacePath" IsReadOnly="True" Background="#22262A" Foreground="#F5F2EA" BorderBrush="#343A40" Padding="10"/></DockPanel>
    </StackPanel>
    <Border Grid.Row="1" Background="#191C1F" BorderBrush="#343A40" BorderThickness="1" CornerRadius="8" Margin="0,24"><StackPanel Margin="18"><TextBlock Text="Sensitive actions" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Atelier records permission choices locally. No network activity or file edits occur in this MVP." Foreground="#AAB2BA" TextWrapping="Wrap" Margin="0,6,0,16"/>
      <CheckBox x:Name="WriteApproval" Content="Approve proposed workspace writes for this review" Margin="0,0,0,8"/>
      <CheckBox x:Name="NetworkApproval" Content="Approve network access for this review" Margin="0,0,0,14"/>
      <Button Content="Record review" Click="RecordReview_Click" HorizontalAlignment="Left" Padding="14,7"/>
      <TextBox x:Name="AuditLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="145" Margin="0,18,0,0" Background="#111315" Foreground="#F5F2EA" BorderBrush="#343A40" Padding="10"/>
    </StackPanel></Border>
    <TextBlock Grid.Row="2" x:Name="Status" Foreground="#6FA8FF" Text="Choose a workspace folder to begin." />
  </Grid>
</Window>
